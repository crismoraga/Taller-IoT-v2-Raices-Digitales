{
  "name": "raices-digitales",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:firmware": "python -m unittest discover -s tests/firmware -v",
    "check": "npm run build && npm test && npm run test:firmware",
    "test:e2e": "playwright test",
    "init": "node scripts/init-local.mjs",
    "predev": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
