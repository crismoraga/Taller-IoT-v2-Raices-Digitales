# Local: copy to .env; use your own password. Production requires HTTPS.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
DATABASE_PATH=data/raices.sqlite
TEACHER_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
SESSION_DAYS=7
RETENTION_DAYS=30
DEVICE_OFFLINE_SECONDS=120
DEVICE_AUDIT_SECONDS=20
# Windows CLI installed automatically under tools/ by scripts/setup-arduino.ps1.
# ARDUINO_CLI_PATH=tools/arduino-cli/arduino-cli.exe
# Docker compose private compiler: at least 32 characters, generated independently.
ARDUINO_SERVICE_TOKEN=
# Public DNS name for Caddy production, no scheme. Example domain is not owned by project.
DOMAIN=
ACME_EMAIL=
